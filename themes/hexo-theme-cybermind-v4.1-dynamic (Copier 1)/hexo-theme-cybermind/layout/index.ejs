<%
// 
// INDEX.EJS - Page d'accueil 100% dynamique
// 

// 
// CONFIGURATION
// 

// Sections à afficher
var sections = theme.sections || {};
var showHero = sections.hero !== false;
var showServices = sections.services !== false;
var showApps = sections.apps !== false;
var showPortfolio = sections.portfolio !== false;
var showArticles = sections.articles !== false;
var showCategories = sections.categories !== false;
var showYoutube = sections.youtube !== false && theme.youtube && theme.youtube.playlist_id;
var showAbout = sections.about !== false;

// Limites d'affichage
var limits = theme.limits || theme.index || {};
var postsLimit = limits.posts || limits.posts_limit || 6;
var servicesLimit = limits.services || limits.services_limit || 3;
var appsLimit = limits.apps || limits.apps_limit || 2;
var portfolioLimit = limits.portfolio || 4;
var categoriesLimit = limits.categories || limits.categories_limit || 6;

// 
// COLLECTE DES CONTENUS DYNAMIQUES
// 

// Services depuis source/services/*.md
var allServices = [];
site.pages.forEach(function(p) {
    var src = p.source || '';
    var pth = p.path || '';
    if ((src.indexOf('services/') === 0 || pth.indexOf('services/') === 0) &&
        src !== 'services/index.md' && pth !== 'services/' && p.layout !== 'services') {
        if (!allServices.find(function(s) { return s.path === p.path; })) {
            allServices.push({
                title: p.title || 'Service',
                path: p.path,
                icon: p.icon || '🔧',
                description: p.description || '',
                order: p.order || 999,
                tags: p.tags ? (Array.isArray(p.tags) ? p.tags : []) : []
            });
        }
    }
});
allServices.sort(function(a, b) { return a.order - b.order; });

// Apps depuis source/apps/*.md OU theme.apps
var allApps = [];
site.pages.forEach(function(p) {
    var src = p.source || '';
    if (p.layout === 'app' || (src.indexOf('apps/') === 0 && src !== 'apps/index.md')) {
        if (!allApps.find(function(a) { return a.path === p.path; })) {
            allApps.push({
                title: p.title,
                path: p.path,
                icon: p.icon || '🚀',
                description: p.description || '',
                embed_url: p.embed_url || '',
                category: p.category || 'tools',
                featured: p.featured || false,
                order: p.order || 999
            });
        }
    }
});
// Ajouter aussi depuis theme.apps si configuré
if (theme.apps && theme.apps.length) {
    theme.apps.forEach(function(app) {
        if (!allApps.find(function(a) { return a.title === app.name; })) {
            allApps.push({
                title: app.name,
                path: app.url,
                icon: app.icon || '🚀',
                description: app.description || '',
                embed_url: app.url,
                category: app.category || 'tools',
                featured: app.featured || false,
                order: app.order || 999,
                isExternal: true
            });
        }
    });
}
allApps.sort(function(a, b) {
    if (a.featured && !b.featured) return -1;
    if (!a.featured && b.featured) return 1;
    return a.order - b.order;
});

// Portfolio depuis source/portfolio/*.md
var allPortfolio = [];
site.pages.forEach(function(p) {
    var src = p.source || '';
    if (p.layout === 'portfolio' || (src.indexOf('portfolio/') === 0 && src !== 'portfolio/index.md')) {
        if (!allPortfolio.find(function(a) { return a.path === p.path; })) {
            allPortfolio.push({
                title: p.title,
                path: p.path,
                icon: p.icon || '💼',
                description: p.description || '',
                thumbnail: p.thumbnail || '',
                type: p.type || 'project',
                client: p.client || {},
                featured: p.featured || false,
                order: p.order || 999
            });
        }
    }
});
allPortfolio.sort(function(a, b) {
    if (a.featured && !b.featured) return -1;
    if (!a.featured && b.featured) return 1;
    return a.order - b.order;
});

// Grille tech configurable
var techGrid = theme.tech_grid || [
    { icon: '🔐', label: 'Security', filter: 'security' },
    { icon: '🐧', label: 'Linux', filter: 'linux' },
    { icon: '💻', label: 'Dev', filter: 'dev' },
    { icon: '📡', label: 'IoT', filter: 'iot' },
    { icon: '⚙️', label: 'Embedded', filter: 'embedded' },
    { icon: '🔬', label: 'Forensic', filter: 'forensic' },
    { icon: '🌐', label: 'Web', filter: 'web' },
    { icon: '🎓', label: 'Formation', filter: 'formation' },
    { icon: '🎲', label: 'Random', filter: 'all' }
];

// Hero configuration
var hero = theme.hero || {};
var heroTitle = hero.title || 'Bienvenue';
var heroSubtitle = hero.subtitle || '';
var heroBadge = hero.badge || '';
var heroStats = hero.stats || [];
var heroCta = hero.cta || [
    { text: 'Découvrir', url: '#articles', style: 'primary' },
    { text: 'Services', url: '#services', style: 'secondary' }
];

// About configuration
var about = theme.about || {};
%>

<!-- 
     HERO SECTION
      -->
<% if (showHero) { %>
<section class="hero">
    <div class="hero-content">
        <% if (heroBadge) { %>
        <div class="hero-badge"><%= heroBadge %></div>
        <% } %>
        
        <h1 class="hero-title"><%- heroTitle %></h1>
        
        <% if (heroSubtitle) { %>
        <p class="hero-subtitle"><%= heroSubtitle %></p>
        <% } %>
        
        <!-- Services highlight (rempli par JS) -->
        <div class="services-hero" id="heroServices"></div>
        
        <p id="filterInfo" class="filter-info"></p>
        
        <% if (heroStats.length > 0) { %>
        <div class="hero-stats">
            <% heroStats.forEach(function(stat) { %>
            <div class="stat">
                <span class="stat-value"><%= stat.value %></span>
                <span class="stat-label"><%= stat.label %></span>
            </div>
            <% }); %>
        </div>
        <% } %>
        
        <div class="hero-cta">
            <% heroCta.forEach(function(btn) { %>
            <a href="<%= btn.url %>" class="btn btn-<%= btn.style || 'primary' %>"><%= btn.text %></a>
            <% }); %>
        </div>
    </div>

    <div class="hero-visual">
        <div class="tech-grid-visual" id="techGrid">
            <% techGrid.forEach(function(tech) { %>
            <div class="tech-cell" data-filter="<%= tech.filter %>" tabindex="0">
                <span class="tech-cell-icon"><%= tech.icon %></span>
                <span class="tech-cell-label"><%= tech.label %></span>
            </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- 
     SERVICES SECTION
      -->
<% if (showServices && allServices.length > 0) { %>
<section id="services" class="section-alt">
    <div class="section-header">
        <div class="section-tag">Expertise</div>
        <h2 class="section-title">Services</h2>
    </div>
    
    <div class="services-grid" id="servicesGrid">
        <% 
        var servicesToShow = servicesLimit > 0 ? allServices.slice(0, servicesLimit) : allServices;
        servicesToShow.forEach(function(service) { 
        %>
        <a href="<%= url_for(service.path) %>" class="service-card" data-tags="<%= (service.tags || []).join(',') %>">
            <div class="service-icon"><%= service.icon %></div>
            <h3><%= service.title %></h3>
            <p><%= service.description %></p>
            <span class="service-link">En savoir plus →</span>
        </a>
        <% }); %>
    </div>
    
    <% if (servicesLimit > 0 && allServices.length > servicesLimit) { %>
    <div class="section-footer">
        <a href="/services/" class="btn btn-secondary">Tous les services (<%= allServices.length %>) →</a>
    </div>
    <% } %>
</section>
<% } %>

<!-- 
     APPS SECTION
      -->
<% if (showApps && allApps.length > 0) { %>
<section id="applications" class="section">
    <div class="section-header">
        <div class="section-tag">Outils</div>
        <h2 class="section-title">Applications</h2>
    </div>
    
    <div class="apps-grid">
        <% 
        var appsToShow = appsLimit > 0 ? allApps.slice(0, appsLimit) : allApps;
        appsToShow.forEach(function(app) { 
        %>
        <div class="app-card">
            <div class="app-preview">
                <% if (app.embed_url) { %>
                <iframe src="<%= app.embed_url %>?embedded=true" title="<%= app.title %>" loading="lazy"></iframe>
                <% } else { %>
                <div class="app-placeholder"><%= app.icon %></div>
                <% } %>
                <div class="app-overlay">
                    <a href="<%= app.isExternal ? app.path : url_for(app.path) %>" <%= app.isExternal ? 'target="_blank"' : '' %> class="btn btn-primary">
                        <%= app.isExternal ? 'Ouvrir ↗' : 'Voir l\'app →' %>
                    </a>
                </div>
            </div>
            <div class="app-info">
                <h3><%= app.icon %> <%= app.title %></h3>
                <p><%= app.description %></p>
            </div>
        </div>
        <% }); %>
    </div>
    
    <% if (appsLimit > 0 && allApps.length > appsLimit) { %>
    <div class="section-footer">
        <a href="/apps/" class="btn btn-secondary">Toutes les applications (<%= allApps.length %>) →</a>
    </div>
    <% } %>
</section>
<% } %>

<!-- 
     PORTFOLIO SECTION
      -->
<% if (showPortfolio && allPortfolio.length > 0) { %>
<section id="portfolio" class="section-alt">
    <div class="section-header">
        <div class="section-tag">Réalisations</div>
        <h2 class="section-title">Portfolio</h2>
    </div>
    
    <div class="portfolio-grid">
        <% 
        var portfolioToShow = portfolioLimit > 0 ? allPortfolio.slice(0, portfolioLimit) : allPortfolio;
        portfolioToShow.forEach(function(item) { 
            var typeColors = { client: '#10b981', project: '#3b82f6', opensource: '#f59e0b' };
            var typeLabels = { client: '🏢 Client', project: '🚀 Projet', opensource: '🔓 OSS' };
        %>
        <a href="<%= url_for(item.path) %>" class="portfolio-card" style="--item-color: <%= typeColors[item.type] || '#f97316' %>">
            <div class="portfolio-visual">
                <% if (item.thumbnail) { %>
                <img src="<%= item.thumbnail %>" alt="<%= item.title %>" loading="lazy">
                <% } else { %>
                <div class="portfolio-placeholder"><%= item.icon %></div>
                <% } %>
                <div class="portfolio-type"><%= typeLabels[item.type] || '📦 Projet' %></div>
            </div>
            <div class="portfolio-info">
                <h3><%= item.icon %> <%= item.title %></h3>
                <p><%= item.description %></p>
                <% if (item.client && item.client.name) { %>
                <span class="portfolio-client">🏢 <%= item.client.name %></span>
                <% } %>
            </div>
        </a>
        <% }); %>
    </div>
    
    <% if (portfolioLimit > 0 && allPortfolio.length > portfolioLimit) { %>
    <div class="section-footer">
        <a href="/portfolio/" class="btn btn-secondary">Tout le portfolio (<%= allPortfolio.length %>) →</a>
    </div>
    <% } %>
</section>
<% } %>

<!-- 
     ARTICLES SECTION
      -->
<% if (showArticles) { %>
<section id="articles" class="section">
    <div class="section-header">
        <div class="section-tag">Blog</div>
        <h2 class="section-title">Articles Récents</h2>
    </div>
    
    <div class="articles-grid">
        <% 
        var postsToShow = postsLimit > 0 ? page.posts.limit(postsLimit) : page.posts;
        postsToShow.each(function(post) { 
        %>
        <%- partial('partials/article', {post: post}) %>
        <% }); %>
    </div>
    
    <% if (page.total > 1) { %>
    <nav class="pagination">
        <%- paginator({ prev_text: '← Précédent', next_text: 'Suivant →', mid_size: 2 }) %>
    </nav>
    <% } %>
    
    <div class="section-footer">
        <a href="/archives/" class="btn btn-secondary">Tous les articles →</a>
    </div>
</section>
<% } %>

<!-- 
     CATEGORIES SECTION
      -->
<% if (showCategories && site.categories && site.categories.length > 0) { %>
<section id="categories" class="section-alt">
    <div class="section-header">
        <div class="section-tag">Thématiques</div>
        <h2 class="section-title">Catégories</h2>
    </div>
    
    <div class="categories-grid">
        <% 
        var defaultColors = ['#00d4ff', '#3b82f6', '#9945ff', '#10b981', '#f59e0b', '#ef4444'];
        var defaultIcons = ['📁', '📂', '🗂️', '📋', '📄', '📝'];
        var allCategories = site.categories.sort('name');
        var categoriesToShow = categoriesLimit > 0 ? allCategories.limit(categoriesLimit) : allCategories;
        var idx = 0;
        categoriesToShow.each(function(cat) {
            var icon = defaultIcons[idx % defaultIcons.length];
            var color = defaultColors[idx % defaultColors.length];
            // Override depuis config si disponible
            if (theme.categories && theme.categories[cat.name.toLowerCase()]) {
                var conf = theme.categories[cat.name.toLowerCase()];
                icon = conf.icon || icon;
                color = conf.color || color;
            }
            idx++;
        %>
        <a href="<%= url_for(cat.path) %>" class="category-card" style="--cat-color: <%= color %>">
            <span class="category-icon"><%= icon %></span>
            <span class="category-name"><%= cat.name %></span>
            <span class="category-count"><%= cat.posts.length %></span>
        </a>
        <% }); %>
    </div>
    
    <% if (categoriesLimit > 0 && allCategories.length > categoriesLimit) { %>
    <div class="section-footer">
        <a href="/categories/" class="btn btn-secondary">Toutes les catégories →</a>
    </div>
    <% } %>
</section>
<% } %>

<!-- 
     YOUTUBE SECTION
      -->
<% if (showYoutube) { %>
<section id="youtube" class="section">
    <div class="section-header">
        <div class="section-tag">Vidéos</div>
        <h2 class="section-title"><%= theme.youtube.title || 'Chaîne YouTube' %></h2>
        <% if (theme.youtube.description) { %>
        <p class="section-subtitle"><%= theme.youtube.description %></p>
        <% } %>
    </div>
    
    <div class="youtube-embed">
        <iframe 
            src="https://www.youtube.com/embed/videoseries?list=<%= theme.youtube.playlist_id %>" 
            frameborder="0" 
            allowfullscreen
            loading="lazy">
        </iframe>
    </div>
</section>
<% } %>

<!-- 
     ABOUT SECTION
      -->
<% if (showAbout && about.name) { %>
<section id="about" class="section-alt">
    <div class="section-header">
        <div class="section-tag">Qui suis-je</div>
        <h2 class="section-title">À propos</h2>
    </div>
    
    <div class="about-content">
        <div class="about-avatar">
            <% if (about.avatar_image) { %>
            <img src="<%= about.avatar_image %>" alt="<%= about.name %>">
            <% } else { %>
            <span class="avatar-emoji"><%= about.avatar || '👨‍💻' %></span>
            <% } %>
        </div>
        
        <div class="about-info">
            <h3><%= about.name %></h3>
            <% if (about.title) { %>
            <p class="about-title"><%= about.title %></p>
            <% } %>
            
            <% if (about.description) { %>
            <div class="about-description"><%- about.description.replace(/\n/g, '<br>') %></div>
            <% } %>
            
            <% if (about.expertise && about.expertise.length) { %>
            <div class="about-expertise">
                <% about.expertise.forEach(function(skill) { %>
                <span class="expertise-tag"><%= skill %></span>
                <% }); %>
            </div>
            <% } %>
            
            <% if (about.stats && about.stats.length) { %>
            <div class="about-stats">
                <% about.stats.forEach(function(stat) { %>
                <div class="about-stat">
                    <span class="stat-value"><%= stat.value %></span>
                    <span class="stat-label"><%= stat.label %></span>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>
    </div>
</section>
<% } %>

<!-- 
     DATA POUR JAVASCRIPT
      -->
<script type="application/json" id="servicesData">
<%- JSON.stringify(allServices) %>
</script>

<!-- 
     STYLES
      -->
<style>
/* 
   SECTIONS
    */
.section {
    padding: 4rem 2rem;
}

.section-alt {
    padding: 4rem 2rem;
    background: var(--bg-secondary);
}

.section-header {
    text-align: center;
    margin-bottom: 3rem;
}

.section-tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--accent-primary);
    color: var(--text-inverted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
}

.section-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

.section-subtitle {
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
}

.section-footer {
    text-align: center;
    margin-top: 3rem;
}

/* 
   HERO
    */
.hero {
    min-height: 90vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding: 4rem;
    align-items: center;
}

.hero-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--glow-primary);
    border: 1px solid var(--accent-primary);
    border-radius: 20px;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
}

.hero-title {
    font-size: 3.5rem;
    line-height: 1.1;
    margin-bottom: 1.5rem;
}

.hero-title .highlight {
    color: var(--accent-primary);
}

.hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 500px;
}

.services-hero {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
}

.filter-info {
    color: var(--accent-primary);
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
    min-height: 1.5rem;
    opacity: 0;
    transition: opacity var(--transition-normal);
}

.filter-info.visible {
    opacity: 1;
}

.hero-stats {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
}

.hero-stats .stat {
    text-align: center;
}

.hero-stats .stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent-primary);
}

.hero-stats .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

/* Tech Grid */
.tech-grid-visual {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 400px;
    margin: 0 auto;
}

.tech-cell {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: all var(--transition-normal);
}

.tech-cell:hover,
.tech-cell.active {
    border-color: var(--accent-primary);
    background: var(--glow-primary);
    transform: scale(1.05);
}

.tech-cell-icon {
    font-size: 2rem;
}

.tech-cell-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
}

/* 
   SERVICES
    */
.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.service-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-normal);
}

.service-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-5px);
    box-shadow: var(--card-hover-shadow);
}

.service-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.service-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
}

.service-card p {
    color: var(--text-secondary);
    flex: 1;
    margin-bottom: 1rem;
}

.service-link {
    color: var(--accent-primary);
    font-weight: 500;
}

/* 
   APPS
    */
.apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.app-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-normal);
}

.app-card:hover {
    border-color: var(--accent-primary);
    box-shadow: var(--card-hover-shadow);
}

.app-preview {
    position: relative;
    height: 250px;
    background: var(--bg-tertiary);
}

.app-preview iframe {
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none;
}

.app-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
}

.app-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
}

.app-card:hover .app-overlay {
    opacity: 1;
}

.app-info {
    padding: 1.5rem;
}

.app-info h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
}

.app-info p {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

/* 
   PORTFOLIO
    */
.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.portfolio-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-normal);
}

.portfolio-card:hover {
    border-color: var(--item-color);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px var(--item-color)20;
}

.portfolio-visual {
    position: relative;
    height: 180px;
    background: var(--bg-tertiary);
}

.portfolio-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.portfolio-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
}

.portfolio-type {
    position: absolute;
    bottom: 10px;
    left: 10px;
    padding: 0.25rem 0.75rem;
