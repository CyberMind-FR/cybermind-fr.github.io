# ═══════════════════════════════════════════════════════════════════════════════
# HEXO THEME CYBERMIND v4.1
# Configuration générique - Personnalisez selon vos besoins
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# APPARENCE
# ─────────────────────────────────────────────────────────────────────────────
theme:
  # Mode par défaut: 'dark' ou 'light'
  default_mode: dark
  
  # Afficher le bouton de changement de thème
  allow_toggle: true
  
  # Couleur d'accent (modifie toute l'interface)
  accent_color: "#f97316"

# ─────────────────────────────────────────────────────────────────────────────
# BRANDING
# ─────────────────────────────────────────────────────────────────────────────
branding:
  logo_symbol: "◆"
  logo_text: "MonSite_"
  tagline: "Votre tagline ici"
  # logo_image: "/images/logo.png"  # Décommentez pour utiliser une image
  # favicon: "/images/favicon.ico"

# ─────────────────────────────────────────────────────────────────────────────
# NAVIGATION
# Liens affichés dans le menu principal
# ─────────────────────────────────────────────────────────────────────────────
menu:
  Accueil: /
  Services: /services/
  Apps: /apps/
  Portfolio: /portfolio/
  Blog: /archives/
  Contact: /contact/

# ─────────────────────────────────────────────────────────────────────────────
# RÉSEAUX SOCIAUX
# Laissez vide pour masquer
# ─────────────────────────────────────────────────────────────────────────────
social:
  email: "contact@example.com"
  github: "https://github.com/votre-compte"
  linkedin: "https://linkedin.com/in/votre-profil"
  youtube: ""
  twitter: ""

# ─────────────────────────────────────────────────────────────────────────────
# PAGE D'ACCUEIL - HERO
# ─────────────────────────────────────────────────────────────────────────────
hero:
  badge: "🚀 Bienvenue"
  title: "Votre<br><span class='highlight'>Titre</span><br>Principal"
  subtitle: "Une description accrocheuse de votre activité ou de votre site."
  stats:
    - value: "10+"
      label: "Années"
    - value: "50+"
      label: "Projets"
    - value: "100%"
      label: "Passion"
  cta:
    - text: "Découvrir"
      url: "#articles"
      style: primary
    - text: "Services"
      url: "#services"
      style: secondary

# ─────────────────────────────────────────────────────────────────────────────
# PAGE D'ACCUEIL - GRILLE TECH
# Personnalisez les icônes et filtres
# ─────────────────────────────────────────────────────────────────────────────
tech_grid:
  - { icon: "🔐", label: "Security", filter: "security" }
  - { icon: "🐧", label: "Linux", filter: "linux" }
  - { icon: "💻", label: "Dev", filter: "dev" }
  - { icon: "📡", label: "IoT", filter: "iot" }
  - { icon: "⚙️", label: "Embedded", filter: "embedded" }
  - { icon: "🔬", label: "Forensic", filter: "forensic" }
  - { icon: "🌐", label: "Web", filter: "web" }
  - { icon: "🎓", label: "Formation", filter: "formation" }
  - { icon: "🎲", label: "Random", filter: "all" }

# ─────────────────────────────────────────────────────────────────────────────
# SECTIONS DE LA PAGE D'ACCUEIL
# true = afficher, false = masquer
# ─────────────────────────────────────────────────────────────────────────────
sections:
  hero: true
  services: true
  apps: true
  portfolio: true
  articles: true
  categories: true
  youtube: false
  about: true

# ─────────────────────────────────────────────────────────────────────────────
# LIMITES D'AFFICHAGE
# Nombre d'éléments sur la page d'accueil (0 = tous)
# ─────────────────────────────────────────────────────────────────────────────
limits:
  posts: 6
  services: 3
  apps: 2
  portfolio: 4
  categories: 6
  tags: 15

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATIONS
# Option 1: Configurer ici (pour apps externes)
# Option 2: Créer des fichiers dans source/apps/*.md (recommandé)
# ─────────────────────────────────────────────────────────────────────────────
# apps:
#   - name: "Mon App"
#     url: "https://app.example.com"
#     icon: "🚀"
#     description: "Description de l'app"
#     category: "tools"
#     featured: true

# ─────────────────────────────────────────────────────────────────────────────
# YOUTUBE
# ─────────────────────────────────────────────────────────────────────────────
youtube:
  playlist_id: ""  # ID de votre playlist YouTube
  title: "Nos vidéos"
  description: "Découvrez nos tutoriels et démonstrations"

# ─────────────────────────────────────────────────────────────────────────────
# À PROPOS
# ─────────────────────────────────────────────────────────────────────────────
about:
  name: "Votre Nom"
  avatar: "👨‍💻"
  # avatar_image: "/images/avatar.jpg"  # Ou une image
  title: "Votre Titre / Métier"
  description: |
    Votre description personnelle.
    
    Elle peut être sur plusieurs lignes et contenir des détails sur votre parcours,
    vos compétences et votre passion.
  expertise:
    - "🔐 Compétence 1"
    - "💻 Compétence 2"
    - "🌐 Compétence 3"
  stats:
    - value: "10+"
      label: "Ans XP"
    - value: "🌍"
      label: "Remote"

# ─────────────────────────────────────────────────────────────────────────────
# CONTACT
# ─────────────────────────────────────────────────────────────────────────────
contact:
  formspree_id: ""  # Créez un compte sur formspree.io
  email: "contact@example.com"
  phone: ""
  address: ""

# ─────────────────────────────────────────────────────────────────────────────
# FOOTER
# ─────────────────────────────────────────────────────────────────────────────
footer:
  copyright: "© 2025 MonSite"
  links:
    - text: "Mentions légales"
      url: "/legal/"
    - text: "Contact"
      url: "/contact/"
  show_theme_credit: true
  theme_repo: "https://github.com/CyberMind-FR/hexo-theme-cybermind"

# ─────────────────────────────────────────────────────────────────────────────
# CATÉGORIES (optionnel)
# Personnaliser icônes et couleurs
# ─────────────────────────────────────────────────────────────────────────────
# categories:
#   security:
#     icon: "🔐"
#     color: "#ef4444"
#   linux:
#     icon: "🐧"
#     color: "#3b82f6"

# ─────────────────────────────────────────────────────────────────────────────
# ARTICLES
# ─────────────────────────────────────────────────────────────────────────────
excerpt_length: 200
read_more: "Lire la suite →"

# ─────────────────────────────────────────────────────────────────────────────
# CODE
# ─────────────────────────────────────────────────────────────────────────────
highlight:
  enable: true
  theme: monokai
  line_number: true

# ─────────────────────────────────────────────────────────────────────────────
# COMMENTAIRES (optionnel)
# ─────────────────────────────────────────────────────────────────────────────
comments:
  enable: false

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS (optionnel)
# ─────────────────────────────────────────────────────────────────────────────
analytics:
  google: ""

# ─────────────────────────────────────────────────────────────────────────────
# RECHERCHE (optionnel)
# ─────────────────────────────────────────────────────────────────────────────
search:
  enable: false
