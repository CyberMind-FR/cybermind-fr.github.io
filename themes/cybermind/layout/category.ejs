<%
var categorySlug = page.category.replace(/\s+/g, '-').toLowerCase();
var categoryConfig = theme.categories[categorySlug] || {};
var categoryName = categoryConfig.name || page.category;
var categoryIcon = categoryConfig.icon || '📁';
var categoryColor = categoryConfig.color || '#f97316';
%>

<section class="category-section">
    <div class="category-hero">
        <div class="category-icon" style="background: linear-gradient(135deg, <%= categoryColor %>33, <%= categoryColor %>11);">
            <span style="font-size: 4rem;"><%= categoryIcon %></span>
        </div>
        <h1 class="category-title"><%= categoryName %></h1>
        <p class="category-count"><%= page.posts.length %> article(s)</p>
    </div>

    <div class="articles-grid">
        <% page.posts.each(post => { %>
            <%- partial('partials/article', {post: post}) %>
        <% }); %>
    </div>

    <% if (page.total > 1) { %>
    <nav class="pagination">
        <%- paginator({
            prev_text: '← Précédent',
            next_text: 'Suivant →',
            mid_size: 2,
            end_size: 1
        }) %>
    </nav>
    <% } %>
</section>
