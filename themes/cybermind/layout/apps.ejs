<section style="padding: 4rem 2rem; min-height: 60vh;">
    <div class="section-header">
        <div class="section-tag">Outils & Applications</div>
        <h2 class="section-title">Applications</h2>
        <p style="text-align: center; color: var(--text-muted); max-width: 600px; margin: 1rem auto 2rem;">
            Découvrez nos applications interactives et outils en ligne
        </p>
    </div>

    <% 
    // Utiliser directement theme.apps de la config
    var allApps = theme.apps || [];
    
    if (allApps.length > 0) { %>
    <div class="apps-grid">
        <% allApps.forEach(function(app) { %>
        <div class="app-card">
            <div class="app-preview">
                <iframe 
                    src="<%= app.url %>?embedded=true" 
                    title="<%= app.name %>"
                    loading="lazy">
                </iframe>
                <div class="app-overlay">
                    <a href="<%= app.url %>" target="_blank" class="btn btn-primary">
                        Ouvrir l'application ↗
                    </a>
                </div>
            </div>
            <div class="app-info">
                <h3><%= app.icon || '🚀' %> <%= app.name %></h3>
                <p><%= app.description || '' %></p>
                <a href="<%= app.url %>" target="_blank" class="app-link">
                    Accéder à l'application →
                </a>
            </div>
        </div>
        <% }); %>
    </div>
    <% } else { %>
    <div style="text-align: center; padding: 3rem; color: var(--text-muted);">
        <p style="font-size: 1.2rem;">Aucune application pour le moment.</p>
        <p>Créez des fichiers .md dans <code>source/apps/</code> ou configurez dans <code>themes/cybermind/_config.yml</code></p>
    </div>
    <% } %>

    <div style="text-align: center; margin-top: 4rem;">
        <a href="/" class="btn btn-secondary">← Retour à l'accueil</a>
    </div>
</section>

<!-- Stats -->
<% if (allApps.length > 0) { %>
<section style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Technologies</div>
        <h2 class="section-title">À propos</h2>
    </div>

    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
        <p style="color: var(--text-secondary); line-height: 1.8; margin-bottom: 2rem;">
            Ces applications ont été développées avec les technologies modernes de développement web
            et sont hébergées sur des plateformes cloud pour garantir leur disponibilité.
        </p>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 2rem; margin-top: 3rem;">
            <div style="background: var(--bg-primary); padding: 2rem; border-radius: 12px; border: 1px solid var(--border-subtle);">
                <div style="font-size: 3rem; margin-bottom: 0.5rem;">🚀</div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--accent-orange);"><%= allApps.length %></div>
                <div style="color: var(--text-muted);">Applications</div>
            </div>

            <div style="background: var(--bg-primary); padding: 2rem; border-radius: 12px; border: 1px solid var(--border-subtle);">
                <div style="font-size: 3rem; margin-bottom: 0.5rem;">☁️</div>
                <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent-orange);">Cloud</div>
                <div style="color: var(--text-muted);">Hébergement</div>
            </div>

            <div style="background: var(--bg-primary); padding: 2rem; border-radius: 12px; border: 1px solid var(--border-subtle);">
                <div style="font-size: 3rem; margin-bottom: 0.5rem;">🔓</div>
                <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent-orange);">Gratuit</div>
                <div style="color: var(--text-muted);">Accès libre</div>
            </div>
        </div>
    </div>
</section>
<% } %>
