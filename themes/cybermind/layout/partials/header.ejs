<nav style="position: sticky; top: 0; width: 100%; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; z-index: 9999; background: rgba(0, 0, 0, 0.98); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,0.06); flex-wrap: wrap;">
    <a href="<%= config.root %>" class="logo" style="font-family: 'JetBrains Mono', monospace; font-size: 1.4rem; font-weight: 600; color: #f97316; text-decoration: none;">◆ CyberMind_</a>
    
    <ul id="navMenu" class="nav-links" style="display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0;">
        <% for (let name in theme.menu) { %>
        <li><a href="<%= url_for(theme.menu[name]) %>" style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #9898a6; text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em;"><%= name %></a></li>
        <% } %>
    </ul>
</nav>

<style>
/* Menu Responsive Vertical */
@media (max-width: 900px) {
    nav {
        flex-direction: column !important;
        padding: 1rem !important;
        gap: 1rem !important;
    }
    
    #navMenu {
        flex-direction: row !important;
        flex-wrap: wrap !important;
        justify-content: center !important;
        gap: 0.5rem !important;
        width: 100% !important;
        padding-top: 1rem !important;
        border-top: 1px solid rgba(255,255,255,0.1) !important;
    }
    
    #navMenu li {
        margin: 0 !important;
    }
    
    #navMenu a {
        display: inline-block !important;
        padding: 0.5rem 0.75rem !important;
        font-size: 0.75rem !important;
        background: rgba(255,255,255,0.05) !important;
        border-radius: 6px !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        transition: all 0.2s ease !important;
    }
    
    #navMenu a:hover,
    #navMenu a:active {
        color: #f97316 !important;
        background: rgba(249, 115, 22, 0.15) !important;
        border-color: #f97316 !important;
    }
}

/* Très petit écran - 2 colonnes */
@media (max-width: 480px) {
    nav {
        padding: 0.75rem !important;
    }
    
    .logo {
        font-size: 1.2rem !important;
    }
    
    #navMenu {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 0.5rem !important;
    }
    
    #navMenu li {
        width: 100% !important;
    }
    
    #navMenu a {
        display: block !important;
        text-align: center !important;
        padding: 0.6rem 0.5rem !important;
        font-size: 0.7rem !important;
    }
}

/* Ultra petit écran - 1 colonne */
@media (max-width: 360px) {
    #navMenu {
        grid-template-columns: 1fr !important;
    }
    
    #navMenu a {
        font-size: 0.75rem !important;
        padding: 0.75rem !important;
    }
}
</style>
