<section style="padding: 4rem 2rem; min-height: 60vh;">
    <div class="section-header">
        <div class="section-tag">Toutes les thématiques</div>
        <h2 class="section-title">Catégories</h2>
        <p style="text-align: center; color: var(--text-muted); max-width: 600px; margin: 1rem auto 2rem;">
            Explorez tous les articles classés par domaine d'expertise
        </p>
    </div>

    <div class="categories-grid">
        <% 
        var defaultColors = ['#00d4ff', '#3b82f6', '#9945ff', '#10b981', '#8b5cf6', '#f59e0b', '#ef4444', '#ec4899', '#06b6d4', '#84cc16'];
        var defaultIcons = ['📁', '📂', '🗂️', '📋', '📄', '📃', '📝', '✏️', '📖', '📚'];
        var categoryIndex = 0;
        
        site.categories.sort('name').each(function(category) {
            // Chercher config dans le thème
            var catConfig = null;
            if (theme.categories) {
                for (var key in theme.categories) {
                    if (theme.categories[key].name === category.name) {
                        catConfig = theme.categories[key];
                        break;
                    }
                }
            }
            
            // Valeurs par défaut
            var icon = catConfig ? catConfig.icon : defaultIcons[categoryIndex % defaultIcons.length];
            var color = catConfig ? catConfig.color : defaultColors[categoryIndex % defaultColors.length];
            
            categoryIndex++;
        %>
        <a href="<%= url_for(category.path) %>" class="category-card" style="--category-color: <%= color %>">
            <div class="category-icon"><%= icon %></div>
            <div class="category-info">
                <h3 class="category-name"><%= category.name %></h3>
                <div class="category-count"><%= category.posts.length %> article<%= category.posts.length > 1 ? 's' : '' %></div>
                <div class="category-preview" style="margin-top: 0.5rem;">
                    <% 
                    var recentPosts = category.posts.sort('date', -1).limit(3);
                    recentPosts.each(function(post, index) { 
                    %>
                        <span style="font-size: 0.85rem; color: var(--text-muted); display: block;">
                            <%= index + 1 %>. <%= post.title.substring(0, 40) %><%= post.title.length > 40 ? '...' : '' %>
                        </span>
                    <% }); %>
                </div>
            </div>
        </a>
        <% }); %>
    </div>

    <% if (site.categories.length === 0) { %>
    <div style="text-align: center; padding: 3rem; color: var(--text-muted);">
        <p style="font-size: 1.2rem;">Aucune catégorie pour le moment.</p>
        <p>Ajoutez des catégories à vos articles pour les voir apparaître ici.</p>
    </div>
    <% } %>

    <div style="text-align: center; margin-top: 4rem;">
        <a href="/" class="btn btn-secondary">← Retour à l'accueil</a>
        <a href="/archives/" class="btn btn-secondary" style="margin-left: 1rem;">Tous les articles</a>
    </div>
</section>

<!-- Stats -->
<% if (site.categories.length > 0) { %>
<section style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Statistiques</div>
        <h2 class="section-title">Vue d'ensemble</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; max-width: 1000px; margin: 0 auto;">
        <div style="background: var(--bg-primary); padding: 2rem; border-radius: 12px; text-align: center; border: 1px solid var(--border-subtle);">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">📁</div>
            <div style="font-size: 2rem; font-weight: 700; color: var(--accent-orange);"><%= site.categories.length %></div>
            <div style="color: var(--text-muted);">Catégories</div>
        </div>

        <div style="background: var(--bg-primary); padding: 2rem; border-radius: 12px; text-align: center; border: 1px solid var(--border-subtle);">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">📝</div>
            <div style="font-size: 2rem; font-weight: 700; color: var(--accent-orange);"><%= site.posts.length %></div>
            <div style="color: var(--text-muted);">Articles</div>
        </div>

        <div style="background: var(--bg-primary); padding: 2rem; border-radius: 12px; text-align: center; border: 1px solid var(--border-subtle);">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">🏆</div>
            <div style="font-size: 2rem; font-weight: 700; color: var(--accent-orange);">
                <%
                var topCategory = site.categories.sort('length', -1).data[0];
                %>
                <%= topCategory ? topCategory.posts.length : 0 %>
            </div>
            <div style="color: var(--text-muted);">Plus populaire</div>
        </div>

        <div style="background: var(--bg-primary); padding: 2rem; border-radius: 12px; text-align: center; border: 1px solid var(--border-subtle);">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">📊</div>
            <div style="font-size: 2rem; font-weight: 700; color: var(--accent-orange);">
                <%= Math.round(site.posts.length / site.categories.length) || 0 %>
            </div>
            <div style="color: var(--text-muted);">Moyenne/catégorie</div>
        </div>
    </div>

    <% if (site.categories.length > 0) { %>
    <div style="margin-top: 3rem; text-align: center;">
        <h3 style="margin-bottom: 1.5rem;">Top 5 catégories</h3>
        <div style="max-width: 600px; margin: 0 auto;">
            <% 
            site.categories.sort('length', -1).limit(5).each(function(category, index) {
                var percentage = Math.round((category.posts.length / site.posts.length) * 100);
            %>
            <div style="margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                    <span><%= index + 1 %>. <%= category.name %></span>
                    <span style="color: var(--text-muted);"><%= category.posts.length %> articles (<%= percentage %>%)</span>
                </div>
                <div style="width: 100%; height: 8px; background: var(--bg-primary); border-radius: 4px; overflow: hidden;">
                    <div style="width: <%= percentage %>%; height: 100%; background: linear-gradient(90deg, var(--accent-orange), var(--accent-amber)); transition: width 0.3s ease;"></div>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
    <% } %>
</section>
<% } %>
