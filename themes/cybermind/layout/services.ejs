<section style="padding: 4rem 2rem; min-height: 60vh;">
    <div class="section-header">
        <div class="section-tag">Services</div>
        <h2 class="section-title">Nos Expertises</h2>
        <p style="text-align: center; color: var(--text-muted); max-width: 700px; margin: 1rem auto 2rem;">
            Fort de plus de 25 ans d'expérience, nous proposons des prestations en cybersécurité et développement embarqué
        </p>
    </div>

    <% if (theme.services && theme.services.length > 0) { %>
    <div class="services-detailed">
        <% theme.services.forEach(service => { %>
        <div class="service-detail-card">
            <div class="service-detail-icon"><%= service.icon %></div>
            <h3><%= service.name %></h3>
            <p><%= service.description %></p>
            <ul class="service-features">
                <% service.features.forEach(feature => { %>
                <li><%= feature %></li>
                <% }); %>
            </ul>
            <a href="/services/<%= service.slug %>/" class="btn btn-primary">En savoir plus →</a>
        </div>
        <% }); %>
    </div>
    <% } else { %>
    <div style="text-align: center; padding: 3rem; color: var(--text-muted);">
        <p style="font-size: 1.2rem;">Aucun service configuré.</p>
        <p>Configurez vos services dans <code>themes/cybermind/_config.yml</code></p>
    </div>
    <% } %>

    <div style="text-align: center; margin-top: 4rem;">
        <h3 style="margin-bottom: 1rem;">Intéressé par nos services ?</h3>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">
            Contactez-nous pour discuter de votre projet
        </p>
        <a href="/contact/" class="btn btn-primary" style="margin-right: 1rem;">📧 Nous contacter</a>
        <a href="/#articles" class="btn btn-secondary">📝 Lire le blog</a>
    </div>
</section>
