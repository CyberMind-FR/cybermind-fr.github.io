<%#
  Layout: blog-index.ejs
  Description: Page d'accueil du blog avec toutes les catégories et articles récents
%>

<%
// Définition des catégories
const categories = [
    { slug: 'cybersecurity', name: '🛡️ Cybersécurité', color: '#00ff88', description: 'Sécurité informatique, pentests, CrowdSec' },
    { slug: 'embedded', name: '⚙️ Embarqué', color: '#ff6600', description: 'ARM, Raspberry Pi, Armbian, U-Boot' },
    { slug: 'linux', name: '🐧 Linux', color: '#ffcc00', description: 'Kernel, administration, open source' },
    { slug: 'creative', name: '🎨 Créativité', color: '#ff6699', description: 'Art génératif, géométrie, musique' },
    { slug: 'philosophy', name: '🧘 Philosophie', color: '#9966ff', description: 'Yi Jing, esprit critique, M00d' },
    { slug: 'tutorials', name: '📖 Tutoriels', color: '#66ccff', description: 'Guides pratiques et how-to' }
];

// Récupérer tous les posts et les trier par date
let allPosts = [];
if (site.posts && site.posts.length) {
    allPosts = site.posts.sort('date', -1).toArray();
}

// Compter les posts par catégorie
function countPostsInCategory(catSlug) {
    return allPosts.filter(function(post) {
        if (post.categories && post.categories.length) {
            return post.categories.some(function(cat) {
                return cat.slug === catSlug || cat.name.toLowerCase().includes(catSlug);
            });
        }
        return post.category === catSlug;
    }).length;
}

// Posts récents (5 derniers)
const recentPosts = allPosts.slice(0, 5);
%>

<div class="blog-index">
    
    <!-- Hero -->
    <header class="blog-hero">
        <h1>📚 Blog CyberMind</h1>
        <p class="blog-tagline">
            Articles sur la cybersécurité, les systèmes embarqués, Linux, la créativité et la philosophie.
        </p>
        <div class="blog-stats">
            <span><%= allPosts.length %> articles</span>
            <span>•</span>
            <span><%= categories.length %> catégories</span>
        </div>
    </header>

    <!-- Catégories -->
    <section class="blog-categories">
        <h2>📁 Catégories</h2>
        <div class="categories-grid">
            <% categories.forEach(function(cat) { %>
            <a href="/blog/<%= cat.slug %>/" class="category-card" style="--cat-color: <%= cat.color %>">
                <div class="category-header">
                    <span class="category-name"><%= cat.name %></span>
                    <span class="category-count"><%= countPostsInCategory(cat.slug) %></span>
                </div>
                <p class="category-desc"><%= cat.description %></p>
            </a>
            <% }); %>
        </div>
    </section>

    <!-- Articles récents -->
    <section class="blog-recent">
        <h2>🕐 Articles récents</h2>
        
        <% if (recentPosts.length > 0) { %>
        <div class="recent-posts">
            <% recentPosts.forEach(function(post) { %>
            <article class="recent-post">
                <a href="<%- url_for(post.path) %>">
                    <div class="post-meta">
                        <span class="post-date"><%= date(post.date, 'DD/MM/YYYY') %></span>
                        <% if (post.category) { %>
                        <span class="post-category"><%= post.category %></span>
                        <% } %>
                    </div>
                    <h3 class="post-title"><%= post.title %></h3>
                    <% if (post.description) { %>
                    <p class="post-excerpt"><%= post.description %></p>
                    <% } %>
                </a>
            </article>
            <% }); %>
        </div>
        <% } else { %>
        <div class="no-posts">
            <p>Aucun article pour le moment.</p>
            <p>Les articles arrivent bientôt ! 🚀</p>
        </div>
        <% } %>
        
        <% if (allPosts.length > 5) { %>
        <div class="see-all">
            <a href="/archives/" class="btn">Voir tous les articles →</a>
        </div>
        <% } %>
    </section>

    <!-- Contenu personnalisé -->
    <% if (page.content && page.content.trim()) { %>
    <section class="blog-content">
        <%- page.content %>
    </section>
    <% } %>

</div>

<style>
/* ══════════════════════════════════════════════════════════════
   BLOG INDEX STYLES
   ══════════════════════════════════════════════════════════════ */

.blog-index {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
}

/* Hero */
.blog-hero {
    text-align: center;
    padding: 3rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle, rgba(255,255,255,0.1));
}

.blog-hero h1 {
    font-size: 2.5rem;
    color: var(--accent-color, #f97316);
    margin-bottom: 1rem;
}

.blog-tagline {
    font-size: 1.1rem;
    color: var(--text-secondary, #9898a6);
    max-width: 600px;
    margin: 0 auto 1rem;
}

.blog-stats {
    display: flex;
    justify-content: center;
    gap: 1rem;
    color: var(--text-muted, #6a6a7a);
    font-size: 0.9rem;
}

/* Catégories */
.blog-categories {
    margin-bottom: 3rem;
}

.blog-categories h2 {
    margin-bottom: 1.5rem;
    color: var(--text-primary, #e8e8ed);
}

.categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
}

.category-card {
    display: block;
    padding: 1.5rem;
    background: var(--bg-secondary, #12121a);
    border: 1px solid var(--border-subtle, rgba(255,255,255,0.1));
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
    border-left: 4px solid var(--cat-color);
}

.category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    border-color: var(--cat-color);
}

.category-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
}

.category-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--cat-color);
}

.category-count {
    background: var(--cat-color);
    color: #000;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 600;
}

.category-desc {
    margin: 0;
    color: var(--text-secondary, #9898a6);
    font-size: 0.9rem;
}

/* Articles récents */
.blog-recent {
    margin-bottom: 3rem;
}

.blog-recent h2 {
    margin-bottom: 1.5rem;
    color: var(--text-primary, #e8e8ed);
}

.recent-posts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.recent-post {
    background: var(--bg-secondary, #12121a);
    border: 1px solid var(--border-subtle, rgba(255,255,255,0.1));
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
}

.recent-post:hover {
    border-color: var(--accent-color, #f97316);
    transform: translateX(5px);
}

.recent-post a {
    display: block;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
}

.recent-post .post-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
}

.recent-post .post-date {
    color: var(--text-muted, #6a6a7a);
}

.recent-post .post-category {
    color: var(--accent-color, #f97316);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.recent-post .post-title {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    color: var(--text-primary, #e8e8ed);
    line-height: 1.4;
}

.recent-post .post-excerpt {
    margin: 0;
    color: var(--text-secondary, #9898a6);
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* No posts */
.no-posts {
    text-align: center;
    padding: 3rem;
    background: var(--bg-secondary, #12121a);
    border-radius: 12px;
    color: var(--text-muted, #6a6a7a);
}

/* See all button */
.see-all {
    text-align: center;
    margin-top: 1.5rem;
}

.btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: 1px solid var(--accent-color, #f97316);
    border-radius: 8px;
    color: var(--accent-color, #f97316);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
}

.btn:hover {
    background: var(--accent-color, #f97316);
    color: #000;
}

/* Blog content */
.blog-content {
    padding: 2rem;
    background: var(--bg-secondary, #12121a);
    border-radius: 12px;
    border-left: 4px solid var(--accent-color, #f97316);
}

/* Responsive */
@media (max-width: 768px) {
    .blog-hero h1 {
        font-size: 1.8rem;
    }
    
    .categories-grid {
        grid-template-columns: 1fr;
    }
}

/* Light mode */
[data-theme="light"] .category-card {
    background: #f8f9fa;
    border-color: #e0e0e0;
}

[data-theme="light"] .recent-post {
    background: #f8f9fa;
    border-color: #e0e0e0;
}

[data-theme="light"] .no-posts,
[data-theme="light"] .blog-content {
    background: #f8f9fa;
}
</style>
