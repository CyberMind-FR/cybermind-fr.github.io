<section class="hero">
    <div class="hero-content">
        <div class="hero-badge">
            <%= theme.hero.badge %>
        </div>
        <h1>
            <%- theme.hero.title %>
        </h1>
        <p class="hero-subtitle">
            <%= theme.hero.subtitle %>
        </p>
        <div class="hero-stats">
            <% theme.hero.stats.forEach(stat => { %>
            <div class="stat">
                <span class="stat-value"><%= stat.value %></span>
                <span class="stat-label"><%= stat.label %></span>
            </div>
            <% }); %>
        </div>
        <div class="hero-cta">
            <a href="<%= url_for('/archives/') %>" class="btn btn-primary">Derniers articles</a>
            <a href="#articles" class="btn btn-secondary">Explorer</a>
        </div>
    </div>

    <div class="hero-visual">
        <div class="tech-grid-visual">
            <div class="tech-cell">
                <span class="tech-cell-icon">🔐</span>
                <span class="tech-cell-label">Security</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">🐧</span>
                <span class="tech-cell-label">Linux</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">💻</span>
                <span class="tech-cell-label">Dev</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">📡</span>
                <span class="tech-cell-label">IoT</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">⚙️</span>
                <span class="tech-cell-label">Embedded</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">🔬</span>
                <span class="tech-cell-label">Research</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">📝</span>
                <span class="tech-cell-label">Tuto</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">🎓</span>
                <span class="tech-cell-label">Learning</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">🚀</span>
                <span class="tech-cell-label">Innovation</span>
            </div>
        </div>
    </div>
</section>

<section id="articles">
    <div class="section-header">
        <div class="section-tag">Articles Récents</div>
        <h2 class="section-title">Dernières Publications</h2>
    </div>

    <div class="articles-grid">
        <% page.posts.each(post => { %>
            <%- partial('partials/article', {post: post}) %>
        <% }); %>
    </div>

    <% if (page.total > 1) { %>
    <nav class="pagination">
        <%- paginator({
            prev_text: '← Précédent',
            next_text: 'Suivant →',
            mid_size: 2,
            end_size: 1
        }) %>
    </nav>
    <% } %>
</section>

<% if (theme.apps && theme.apps.length > 0) { %>
<section id="applications">
    <div class="section-header">
        <div class="section-tag">Outils</div>
        <h2 class="section-title">Applications & Ressources</h2>
    </div>

    <div class="apps-grid">
        <% theme.apps.forEach(app => { %>
        <div class="app-card">
            <div class="app-preview">
                <iframe 
                    src="<%= app.url %>?embedded=true" 
                    title="<%= app.name %>"
                    loading="lazy">
                </iframe>
                <div class="app-overlay">
                    <a href="<%= app.url %>" target="_blank" class="btn btn-primary">
                        Ouvrir l'application ↗
                    </a>
                </div>
            </div>
            <div class="app-info">
                <h3><%= app.icon %> <%= app.name %></h3>
                <p><%= app.description %></p>
                <a href="<%= app.url %>" target="_blank" class="app-link">
                    Accéder à l'application →
                </a>
            </div>
        </div>
        <% }); %>
    </div>
</section>
<% } %>

<% if (theme.youtube && theme.youtube.playlist_id) { %>
<section id="creations">
    <div class="section-header">
        <div class="section-tag">Réalisations</div>
        <h2 class="section-title">Portfolio & Démonstrations</h2>
    </div>

    <div class="media-showcase">
        <div class="youtube-embed">
            <iframe 
                src="https://www.youtube.com/embed/videoseries?list=<%= theme.youtube.playlist_id %>" 
                title="<%= theme.youtube.title %>"
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
            </iframe>
        </div>
        
        <div class="media-info">
            <h3>🎬 <%= theme.youtube.title %></h3>
            <p><%= theme.youtube.description %></p>
            
            <div class="media-tags">
                <% theme.youtube.tags.forEach(tag => { %>
                <span class="media-tag"><%= tag %></span>
                <% }); %>
            </div>
            
            <a href="https://www.youtube.com/playlist?list=<%= theme.youtube.playlist_id %>" 
               class="btn btn-primary" 
               target="_blank"
               style="margin-top: 1rem;">
                Voir la chaîne →
            </a>
        </div>
    </div>
</section>
<% } %>

<section id="apropos">
    <div class="section-header">
        <div class="section-tag">À propos</div>
        <h2 class="section-title">Expertise & Parcours</h2>
    </div>

    <div class="about-content">
        <div class="about-text">
            <h3><%= theme.about.name %> — <%= theme.about.title %></h3>
            <%- markdown(theme.about.description) %>
            <div class="expertise-list">
                <% theme.about.expertise.forEach(item => { %>
                <span class="expertise-tag"><%= item %></span>
                <% }); %>
            </div>
        </div>

        <div class="about-visual">
            <div class="profile-card">
                <div class="profile-avatar"><%= theme.about.avatar %></div>
                <h4 class="profile-name"><%= theme.about.name %></h4>
                <p class="profile-title"><%= theme.about.title %></p>
                <div class="profile-stats">
                    <% theme.about.stats.forEach(stat => { %>
                    <div class="profile-stat">
                        <span class="profile-stat-value"><%= stat.value %></span>
                        <span class="profile-stat-label"><%= stat.label %></span>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="contact">
    <div class="section-header">
        <div class="section-tag">Contact</div>
        <h2 class="section-title">Restons en Contact</h2>
    </div>

    <div class="contact-content">
        <div class="contact-info">
            <h3>Une question ? Un projet ?</h3>
            <p>
                Pour toute demande de prestation (pentest, développement, conseil), 
                contribution au blog, ou simplement pour échanger sur les technologies.
            </p>
            <div class="contact-methods">
                <% for (let name in theme.social) { %>
                <a href="<%= name === 'email' ? 'mailto:' + theme.social[name] : theme.social[name] %>" class="contact-method" target="_blank">
                    <div class="contact-method-icon">
                        <% if (name === 'email') { %>📧<% } %>
                        <% if (name === 'website') { %>🌐<% } %>
                        <% if (name === 'linkedin') { %>💼<% } %>
                        <% if (name === 'github') { %>💻<% } %>
                    </div>
                    <div>
                        <strong><%= name.charAt(0).toUpperCase() + name.slice(1) %></strong>
                        <div style="color: var(--text-muted); font-size: 0.9rem;"><%= theme.social[name] %></div>
                    </div>
                </a>
                <% } %>
            </div>
        </div>

        <% if (theme.contact && theme.contact.formspree_id) { %>
        <div class="contact-form">
            <form action="https://formspree.io/f/<%= theme.contact.formspree_id %>" method="POST">
                <input type="hidden" name="_subject" value="📧 Contact CyberMind Blog">
                <input type="hidden" name="_next" value="<%= config.url %>/merci/">
                <input type="text" name="_gotcha" style="display:none">
                
                <div class="form-group">
                    <label for="name">Nom / Organisation</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="sujet">Sujet</label>
                    <select id="sujet" name="sujet">
                        <% theme.contact.subjects.forEach(subject => { %>
                        <option value="<%= subject.value %>"><%= subject.label %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Décrivez votre demande..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-submit">Envoyer</button>
            </form>
        </div>
        <% } %>
    </div>
</section>
