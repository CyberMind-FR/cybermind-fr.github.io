<section class="hero">
    <div class="hero-content">
        <div class="hero-badge"><%= theme.hero.badge %></div>
        <h1><%- theme.hero.title %></h1>
        <p class="hero-subtitle"><%= theme.hero.subtitle %></p>
        
        <!-- Services filtrés dynamiquement -->
        <div class="services-hero" id="heroServices">
            <!-- Rempli par JS -->
        </div>
        
        <p id="filterInfo" style="text-align: center; color: var(--accent-orange); font-size: 0.85rem; margin-top: 1rem; opacity: 0; transition: opacity 0.3s;">
            <!-- Info filtre actif -->
        </p>
        
        <div class="hero-stats">
            <% if (theme.hero && theme.hero.stats) { theme.hero.stats.forEach(function(stat) { %>
            <div class="stat">
                <span class="stat-value"><%= stat.value %></span>
                <span class="stat-label"><%= stat.label %></span>
            </div>
            <% }); } %>
        </div>
        
        <div class="hero-cta">
            <a href="#articles" class="btn btn-primary">Découvrir le blog</a>
            <a href="#services" class="btn btn-secondary">Nos services</a>
        </div>
    </div>

    <div class="hero-visual">
        <div class="tech-grid-visual" id="techGrid">
            <div class="tech-cell" data-filter="security" tabindex="0">
                <span class="tech-cell-icon">🔐</span>
                <span class="tech-cell-label">Security</span>
            </div>
            <div class="tech-cell" data-filter="linux" tabindex="0">
                <span class="tech-cell-icon">🐧</span>
                <span class="tech-cell-label">Linux</span>
            </div>
            <div class="tech-cell" data-filter="dev" tabindex="0">
                <span class="tech-cell-icon">💻</span>
                <span class="tech-cell-label">Dev</span>
            </div>
            <div class="tech-cell" data-filter="iot" tabindex="0">
                <span class="tech-cell-icon">📡</span>
                <span class="tech-cell-label">IoT</span>
            </div>
            <div class="tech-cell" data-filter="embedded" tabindex="0">
                <span class="tech-cell-icon">⚙️</span>
                <span class="tech-cell-label">Embedded</span>
            </div>
            <div class="tech-cell" data-filter="forensic" tabindex="0">
                <span class="tech-cell-icon">🔬</span>
                <span class="tech-cell-label">Forensic</span>
            </div>
            <div class="tech-cell" data-filter="web" tabindex="0">
                <span class="tech-cell-icon">🌐</span>
                <span class="tech-cell-label">Web</span>
            </div>
            <div class="tech-cell" data-filter="formation" tabindex="0">
                <span class="tech-cell-icon">🎓</span>
                <span class="tech-cell-label">Formation</span>
            </div>
            <div class="tech-cell" data-filter="all" tabindex="0">
                <span class="tech-cell-icon">🎲</span>
                <span class="tech-cell-label">Random</span>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<%
var showServices = !(theme.sections && theme.sections.services === false);
var allServices = [];
if (site.pages && site.pages.length) {
    site.pages.forEach(function(page) {
        var src = page.source || '';
        var pth = page.path || '';
        
        var isServicePage = (src.indexOf('services/') >= 0 || pth.indexOf('services/') >= 0) &&
                           src !== 'services/index.md' &&
                           pth !== 'services/' &&
                           pth !== 'services/index.html' &&
                           page.layout !== 'services';
        
        if (isServicePage) {
            var exists = allServices.some(function(s) { return s.path === page.path; });
            if (!exists) {
                // Déterminer les tags en fonction du chemin/titre
                var tags = [];
                var pathLower = pth.toLowerCase();
                var titleLower = (page.title || '').toLowerCase();
                
                if (pathLower.indexOf('pentest') >= 0 || titleLower.indexOf('pentest') >= 0 || titleLower.indexOf('sécurité') >= 0) {
                    tags.push('security', 'forensic');
                }
                if (pathLower.indexOf('dev') >= 0 || titleLower.indexOf('développement') >= 0) {
                    tags.push('dev', 'linux', 'embedded');
                }
                if (pathLower.indexOf('formation') >= 0 || titleLower.indexOf('formation') >= 0) {
                    tags.push('formation', 'security', 'linux');
                }
                if (pathLower.indexOf('forensic') >= 0 || titleLower.indexOf('forensic') >= 0 || titleLower.indexOf('investigation') >= 0) {
                    tags.push('forensic', 'security');
                }
                if (pathLower.indexOf('gk2') >= 0 || titleLower.indexOf('web') >= 0 || titleLower.indexOf('hébergement') >= 0) {
                    tags.push('web', 'dev');
                }
                if (pathLower.indexOf('embedded') >= 0 || titleLower.indexOf('embarqué') >= 0 || titleLower.indexOf('openwrt') >= 0 || titleLower.indexOf('arm') >= 0) {
                    tags.push('embedded', 'linux', 'iot', 'security');
                }
                
                // Tags par défaut si aucun trouvé
                if (tags.length === 0) {
                    tags.push('dev');
                }
                
                allServices.push({
                    path: page.path,
                    title: page.title,
                    icon: page.icon || '⚙️',
                    description: page.description || '',
                    features: page.features || [],
                    order: page.order || 999,
                    tags: tags
                });
            }
        }
    });
}
allServices.sort(function(a, b) { return (a.order || 999) - (b.order || 999); });
%>

<!-- Données des services pour JavaScript -->
<script id="servicesData" type="application/json">
<%- JSON.stringify(allServices) %>
</script>

<% if (showServices && allServices.length > 0) { %>
<section id="services" style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Services</div>
        <h2 class="section-title">Nos Expertises</h2>
        <p id="servicesFilterInfo" style="text-align: center; color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem;">
            🎲 Cliquez sur les icônes à droite pour filtrer
        </p>
    </div>
    <div class="services-detailed" id="servicesGrid">
        <!-- Rempli par JavaScript -->
    </div>
    <div style="text-align: center; margin-top: 3rem;">
        <button onclick="resetFilter()" class="btn btn-secondary" style="margin-right: 1rem;">🔄 Réinitialiser</button>
        <a href="/services/" class="btn btn-primary">Voir tous les services (<%= allServices.length %>) →</a>
    </div>
</section>
<% } %>

<style>
/* Styles pour l'interaction */
.tech-cell {
    cursor: pointer;
    transition: all 0.3s ease;
}

.tech-cell:hover,
.tech-cell:focus {
    transform: scale(1.1);
    border-color: var(--accent-orange) !important;
    box-shadow: 0 0 20px rgba(249, 115, 22, 0.4);
}

.tech-cell.active {
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.3), rgba(245, 158, 11, 0.2)) !important;
    border-color: var(--accent-orange) !important;
    box-shadow: 0 0 25px rgba(249, 115, 22, 0.5);
    transform: scale(1.05);
}

.tech-cell.active .tech-cell-icon {
    animation: bounce 0.5s ease;
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
}

.service-card-hero,
.service-detail-card {
    transition: all 0.4s ease;
}

.service-card-hero.fade-in,
.service-detail-card.fade-in {
    animation: fadeInScale 0.4s ease forwards;
}

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: translateY(20px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

#filterInfo {
    min-height: 1.5rem;
}

/* Animation pulse sur les cases */
.tech-cell.pulse {
    animation: pulse-glow 1s ease infinite;
}

@keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 5px rgba(249, 115, 22, 0.2); }
    50% { box-shadow: 0 0 20px rgba(249, 115, 22, 0.4); }
}
</style>

<script>
(function() {
    // Récupérer les données des services
    var servicesDataEl = document.getElementById('servicesData');
    if (!servicesDataEl) return;
    
    var allServices = [];
    try {
        allServices = JSON.parse(servicesDataEl.textContent);
    } catch(e) {
        console.error('Erreur parsing services:', e);
        return;
    }
    
    if (!allServices || allServices.length === 0) return;
    
    var currentFilter = 'all';
    
    // Mapping des filtres vers les labels
    var filterLabels = {
        'security': '🔐 Sécurité',
        'linux': '🐧 Linux',
        'dev': '💻 Développement',
        'iot': '📡 IoT',
        'embedded': '⚙️ Embarqué',
        'forensic': '🔬 Forensic',
        'web': '🌐 Web',
        'formation': '🎓 Formation',
        'all': '🎲 Tous'
    };
    
    // Fonction de mélange Fisher-Yates
    function shuffle(array) {
        var arr = array.slice();
        for (var i = arr.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }
        return arr;
    }
    
    // Filtrer les services par tag
    function filterServices(tag) {
        if (tag === 'all') {
            return shuffle(allServices);
        }
        var filtered = allServices.filter(function(s) {
            return s.tags && s.tags.indexOf(tag) >= 0;
        });
        return filtered.length > 0 ? filtered : shuffle(allServices).slice(0, 2);
    }
    
    // Générer le HTML d'une carte service (hero)
    function renderHeroCard(service) {
        var shortTitle = service.title.replace(/^[^\s]+\s*/, '').substring(0, 25);
        if (shortTitle.length >= 25) shortTitle += '...';
        
        return '<a href="/' + service.path + '" class="service-card-hero fade-in">' +
               '<div class="service-icon-hero">' + service.icon + '</div>' +
               '<h3>' + shortTitle + '</h3>' +
               '<p>' + (service.description ? service.description.substring(0, 50) + '...' : '') + '</p>' +
               '</a>';
    }
    
    // Générer le HTML d'une carte service (détaillée)
    function renderDetailCard(service) {
        var featuresHtml = '';
        if (service.features && service.features.length > 0) {
            featuresHtml = '<ul class="service-features">';
            for (var i = 0; i < Math.min(service.features.length, 4); i++) {
                featuresHtml += '<li>' + service.features[i] + '</li>';
            }
            featuresHtml += '</ul>';
        }
        
        return '<div class="service-detail-card fade-in">' +
               '<div class="service-detail-icon">' + service.icon + '</div>' +
               '<h3>' + service.title + '</h3>' +
               '<p>' + service.description + '</p>' +
               featuresHtml +
               '<a href="/' + service.path + '" class="btn btn-primary">En savoir plus →</a>' +
               '</div>';
    }
    
    // Mettre à jour l'affichage des services
    function updateDisplay(filter) {
        currentFilter = filter;
        var filtered = filterServices(filter);
        
        // Hero services (max 2)
        var heroEl = document.getElementById('heroServices');
        if (heroEl) {
            var heroHtml = '';
            var heroServices = filtered.slice(0, Math.min(2, filtered.length));
            for (var i = 0; i < heroServices.length; i++) {
                heroHtml += renderHeroCard(heroServices[i]);
            }
            heroEl.innerHTML = heroHtml;
        }
        
        // Grid services (max 3)
        var gridEl = document.getElementById('servicesGrid');
        if (gridEl) {
            var gridHtml = '';
            var gridServices = filtered.slice(0, Math.min(3, filtered.length));
            for (var j = 0; j < gridServices.length; j++) {
                gridHtml += renderDetailCard(gridServices[j]);
            }
            gridEl.innerHTML = gridHtml;
        }
        
        // Info filtre
        var filterInfo = document.getElementById('filterInfo');
        var servicesFilterInfo = document.getElementById('servicesFilterInfo');
        
        if (filter !== 'all') {
            if (filterInfo) {
                filterInfo.textContent = '🎯 Filtre actif : ' + filterLabels[filter] + ' (' + filtered.length + ' service' + (filtered.length > 1 ? 's' : '') + ')';
                filterInfo.style.opacity = '1';
            }
            if (servicesFilterInfo) {
                servicesFilterInfo.innerHTML = '🎯 <strong>' + filterLabels[filter] + '</strong> — ' + filtered.length + ' service' + (filtered.length > 1 ? 's' : '') + ' correspondant' + (filtered.length > 1 ? 's' : '');
                servicesFilterInfo.style.color = 'var(--accent-orange)';
            }
        } else {
            if (filterInfo) {
                filterInfo.textContent = '🎲 Sélection aléatoire';
                filterInfo.style.opacity = '0.7';
            }
            if (servicesFilterInfo) {
                servicesFilterInfo.innerHTML = '🎲 Cliquez sur les icônes à droite pour filtrer';
                servicesFilterInfo.style.color = 'var(--text-muted)';
            }
        }
        
        // Mettre à jour les classes actives
        var cells = document.querySelectorAll('.tech-cell');
        for (var k = 0; k < cells.length; k++) {
            var cell = cells[k];
            if (cell.getAttribute('data-filter') === filter) {
                cell.classList.add('active');
            } else {
                cell.classList.remove('active');
            }
        }
    }
    
    // Fonction globale pour réinitialiser
    window.resetFilter = function() {
        updateDisplay('all');
    };
    
    // Initialiser les événements sur la grille tech
    function initTechGrid() {
        var cells = document.querySelectorAll('.tech-cell[data-filter]');
        
        for (var i = 0; i < cells.length; i++) {
            (function(cell) {
                // Click
                cell.addEventListener('click', function(e) {
                    e.preventDefault();
                    var filter = this.getAttribute('data-filter');
                    updateDisplay(filter);
                });
                
                // Keyboard (Enter/Space)
                cell.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        var filter = this.getAttribute('data-filter');
                        updateDisplay(filter);
                    }
                });
                
                // Touch
                cell.addEventListener('touchend', function(e) {
                    e.preventDefault();
                    var filter = this.getAttribute('data-filter');
                    updateDisplay(filter);
                });
            })(cells[i]);
        }
    }
    
    // Initialisation
    function init() {
        initTechGrid();
        updateDisplay('all');
    }
    
    // Lancer l'initialisation
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>

<!-- Blog Articles -->
<section id="articles" style="padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Blog Technique</div>
        <h2 class="section-title">Articles Récents</h2>
        <p style="text-align: center; color: var(--text-muted); max-width: 600px; margin: 1rem auto 0;">
            Découvrez nos derniers articles sur la cybersécurité, le développement embarqué et les technologies open source
        </p>
    </div>
    <div class="articles-grid">
        <% 
        var postsLimit = (theme.index && theme.index.posts_limit) || 6;
        var postsToShow = postsLimit > 0 ? page.posts.limit(postsLimit) : page.posts;
        postsToShow.each(function(post) { %>
            <%- partial('partials/article', {post: post}) %>
        <% }); %>
    </div>
    <% if (page.total > 1) { %>
    <nav class="pagination">
        <%- paginator({ prev_text: '← Précédent', next_text: 'Suivant →', mid_size: 2, end_size: 1 }) %>
    </nav>
    <% } %>
    <div style="text-align: center; margin-top: 3rem;">
        <a href="/archives/" class="btn btn-secondary">Voir tous les articles →</a>
    </div>
</section>

<!-- Categories Section -->
<%
var showCategories = !(theme.sections && theme.sections.categories === false);
var categoriesExist = site.categories && site.categories.length > 0;
if (showCategories && categoriesExist) {
%>
<section id="categories" style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Thématiques</div>
        <h2 class="section-title">Explorer par Catégorie</h2>
    </div>
    <div class="categories-grid">
        <% 
        var defaultColors = ['#00d4ff', '#3b82f6', '#9945ff', '#10b981', '#8b5cf6', '#f59e0b', '#ef4444', '#ec4899', '#06b6d4', '#84cc16'];
        var defaultIcons = ['📁', '📂', '🗂️', '📋', '📄', '📃', '📝', '✏️', '📖', '📚'];
        var categoriesLimit = (theme.index && theme.index.categories_limit) || 6;
        var allCategories = site.categories.sort('name');
        var categoriesToShow = categoriesLimit > 0 ? allCategories.limit(categoriesLimit) : allCategories;
        var idx = 0;
        categoriesToShow.each(function(category) {
            var icon = defaultIcons[idx % 10];
            var color = defaultColors[idx % 10];
            if (theme.categories) {
                for (var key in theme.categories) {
                    if (theme.categories[key].name === category.name) {
                        icon = theme.categories[key].icon || icon;
                        color = theme.categories[key].color || color;
                    }
                }
            }
            idx++;
        %>
        <a href="<%= url_for(category.path) %>" class="category-card" style="--category-color: <%= color %>">
            <div class="category-icon"><%= icon %></div>
            <div class="category-info">
                <h3 class="category-name"><%= category.name %></h3>
                <div class="category-count"><%= category.posts.length %> article<%= category.posts.length > 1 ? 's' : '' %></div>
            </div>
        </a>
        <% }); %>
    </div>
    <% if (categoriesLimit > 0 && allCategories.length > categoriesLimit) { %>
    <div style="text-align: center; margin-top: 3rem;">
        <a href="/categories/" class="btn btn-secondary">Voir toutes les catégories (<%= allCategories.length %>) →</a>
    </div>
    <% } %>
</section>
<% } %>

<!-- Tags Section -->
<%
var showTags = theme.sections && theme.sections.tags === true;
var tagsExist = site.tags && site.tags.length > 0;
if (showTags && tagsExist) {
%>
<section id="tags" style="padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Mots-clés</div>
        <h2 class="section-title">Explorer par Tag</h2>
    </div>
    <div class="tags-cloud" style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
        <% 
        var defaultColors = ['#00d4ff', '#3b82f6', '#9945ff', '#10b981', '#8b5cf6', '#f59e0b', '#ef4444', '#ec4899', '#06b6d4', '#84cc16'];
        var tagsLimit = (theme.index && theme.index.tags_limit) || 10;
        var allTags = site.tags.sort('length', -1);
        var tagsToShow = tagsLimit > 0 ? allTags.limit(tagsLimit) : allTags;
        var idx = 0;
        tagsToShow.each(function(tag) {
            var color = defaultColors[idx % 10];
            var fontSize = 0.85 + (Math.min(tag.posts.length, 10) * 0.1);
            idx++;
        %>
        <a href="<%= url_for(tag.path) %>" style="font-size:<%= fontSize %>rem;color:<%= color %>;text-decoration:none;padding:0.5rem 1rem;background:linear-gradient(135deg,<%= color %>15,<%= color %>08);border:1px solid <%= color %>30;border-radius:8px;">
            #<%= tag.name %> <span style="background:<%= color %>25;padding:0.2rem 0.5rem;border-radius:4px;font-size:0.85rem;font-weight:600;"><%= tag.posts.length %></span>
        </a>
        <% }); %>
    </div>
    <% if (tagsLimit > 0 && allTags.length > tagsLimit) { %>
    <div style="text-align: center; margin-top: 3rem;">
        <a href="/tags/" class="btn btn-secondary">Voir tous les tags (<%= allTags.length %>) →</a>
    </div>
    <% } %>
</section>
<% } %>

<!-- Apps Section -->
<%
var showApps = !(theme.sections && theme.sections.apps === false);
var appsExist = theme.apps && theme.apps.length > 0;
if (showApps && appsExist) {
%>
<section id="applications" style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Outils</div>
        <h2 class="section-title">Applications & Ressources</h2>
    </div>
    <div class="apps-grid">
        <% 
        var appsLimit = (theme.index && theme.index.apps_limit) || 2;
        var appsToShow = appsLimit > 0 ? theme.apps.slice(0, appsLimit) : theme.apps;
        appsToShow.forEach(function(app) { %>
        <div class="app-card">
            <div class="app-preview">
                <iframe src="<%= app.url %>?embedded=true" title="<%= app.name %>" loading="lazy"></iframe>
                <div class="app-overlay">
                    <a href="<%= app.url %>" target="_blank" class="btn btn-primary">Ouvrir ↗</a>
                </div>
            </div>
            <div class="app-info">
                <h3><%= app.icon || '🚀' %> <%= app.name %></h3>
                <p><%= app.description || '' %></p>
                <a href="<%= app.url %>" target="_blank" class="app-link">Accéder →</a>
            </div>
        </div>
        <% }); %>
    </div>
    <% if (appsLimit > 0 && theme.apps.length > appsLimit) { %>
    <div style="text-align: center; margin-top: 3rem;">
        <a href="/apps/" class="btn btn-secondary">Voir toutes les applications (<%= theme.apps.length %>) →</a>
    </div>
    <% } %>
</section>
<% } %>

<!-- YouTube Section -->
<% if (theme.youtube && theme.youtube.playlist_id) { %>
<section id="creations" style="padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Réalisations</div>
        <h2 class="section-title">Portfolio & Démonstrations</h2>
    </div>
    <div class="media-showcase">
        <div class="youtube-embed">
            <iframe src="https://www.youtube.com/embed/videoseries?list=<%= theme.youtube.playlist_id %>" title="<%= theme.youtube.title %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
        <div class="media-info">
            <h3>🎬 <%= theme.youtube.title %></h3>
            <p><%= theme.youtube.description %></p>
            <% if (theme.youtube.tags) { %>
            <div class="media-tags">
                <% theme.youtube.tags.forEach(function(tag) { %><span class="media-tag"><%= tag %></span><% }); %>
            </div>
            <% } %>
            <a href="https://www.youtube.com/playlist?list=<%= theme.youtube.playlist_id %>" class="btn btn-primary" target="_blank" style="margin-top: 1rem;">Voir la chaîne →</a>
        </div>
    </div>
</section>
<% } %>

<!-- About Section -->
<% if (theme.about) { %>
<section id="apropos" style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">À propos</div>
        <h2 class="section-title">Expertise & Parcours</h2>
    </div>
    <div class="about-content">
        <div class="about-text">
            <h3><%= theme.about.name %> — <%= theme.about.title %></h3>
            <%- markdown(theme.about.description) %>
            <% if (theme.about.expertise) { %>
            <div class="expertise-list">
                <% theme.about.expertise.forEach(function(item) { %><span class="expertise-tag"><%= item %></span><% }); %>
            </div>
            <% } %>
        </div>
        <div class="about-visual">
            <div class="profile-card">
                <div class="profile-avatar"><%= theme.about.avatar %></div>
                <h4 class="profile-name"><%= theme.about.name %></h4>
                <p class="profile-title"><%= theme.about.title %></p>
                <% if (theme.about.stats) { %>
                <div class="profile-stats">
                    <% theme.about.stats.forEach(function(stat) { %>
                    <div class="profile-stat">
                        <span class="profile-stat-value"><%= stat.value %></span>
                        <span class="profile-stat-label"><%= stat.label %></span>
                    </div>
                    <% }); %>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>
<% } %>

<!-- Contact Section -->
<section id="contact" style="padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Contact</div>
        <h2 class="section-title">Restons en Contact</h2>
    </div>
    <div class="contact-content">
        <div class="contact-info">
            <h3>Une question ? Un projet ?</h3>
            <p>Pour toute demande de prestation, contribution au blog, ou simplement pour échanger.</p>
            <% if (theme.social) { %>
            <div class="contact-methods">
                <% for (var name in theme.social) { %>
                <a href="<%= name === 'email' ? 'mailto:' + theme.social[name] : theme.social[name] %>" class="contact-method" target="_blank">
                    <div class="contact-method-icon"><% if (name === 'email') { %>📧<% } else if (name === 'website') { %>🌐<% } else if (name === 'linkedin') { %>💼<% } else if (name === 'github') { %>💻<% } else { %>🔗<% } %></div>
                    <div><strong><%= name.charAt(0).toUpperCase() + name.slice(1) %></strong><div style="color: var(--text-muted); font-size: 0.9rem;"><%= theme.social[name] %></div></div>
                </a>
                <% } %>
            </div>
            <% } %>
        </div>
        <% if (theme.contact && theme.contact.formspree_id) { %>
        <div class="contact-form">
            <form action="https://formspree.io/f/<%= theme.contact.formspree_id %>" method="POST">
                <input type="hidden" name="_subject" value="📧 Contact CyberMind Blog">
                <div class="form-group"><label for="name">Nom</label><input type="text" id="name" name="name" required></div>
                <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" required></div>
                <div class="form-group"><label for="sujet">Sujet</label>
                    <select id="sujet" name="sujet">
                        <% if (theme.contact.subjects) { theme.contact.subjects.forEach(function(s) { %><option value="<%= s.value %>"><%= s.label %></option><% }); } %>
                    </select>
                </div>
                <div class="form-group"><label for="message">Message</label><textarea id="message" name="message"></textarea></div>
                <button type="submit" class="btn btn-primary btn-submit">Envoyer</button>
            </form>
        </div>
        <% } %>
    </div>
</section>
