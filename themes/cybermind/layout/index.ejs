<section class="hero">
    <div class="hero-content">
        <div class="hero-badge">
            <%= theme.hero.badge %>
        </div>
        <h1>
            <%- theme.hero.title %>
        </h1>
        <p class="hero-subtitle">
            <%= theme.hero.subtitle %>
        </p>
        
        <!-- Services Cards in Hero -->
        <div class="services-hero">
            <a href="/services/pentest/" class="service-card-hero">
                <div class="service-icon-hero">🛡️</div>
                <h3>Pentest & Sécurité</h3>
                <p>Audit de sécurité et tests d'intrusion</p>
            </a>
            
            <a href="/services/dev/" class="service-card-hero">
                <div class="service-icon-hero">⚙️</div>
                <h3>Dev & Conseil</h3>
                <p>Développement embarqué et conseil technique</p>
            </a>
        </div>
        
        <div class="hero-stats">
            <% theme.hero.stats.forEach(stat => { %>
            <div class="stat">
                <span class="stat-value"><%= stat.value %></span>
                <span class="stat-label"><%= stat.label %></span>
            </div>
            <% }); %>
        </div>
        
        <div class="hero-cta">
            <a href="#articles" class="btn btn-primary">Découvrir le blog</a>
            <a href="#services" class="btn btn-secondary">Nos services</a>
        </div>
    </div>

    <div class="hero-visual">
        <div class="tech-grid-visual">
            <div class="tech-cell">
                <span class="tech-cell-icon">🔐</span>
                <span class="tech-cell-label">Security</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">🐧</span>
                <span class="tech-cell-label">Linux</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">💻</span>
                <span class="tech-cell-label">Dev</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">📡</span>
                <span class="tech-cell-label">IoT</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">⚙️</span>
                <span class="tech-cell-label">Embedded</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">🔬</span>
                <span class="tech-cell-label">Research</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">📝</span>
                <span class="tech-cell-label">Tuto</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">🎓</span>
                <span class="tech-cell-label">Learning</span>
            </div>
            <div class="tech-cell">
                <span class="tech-cell-icon">🚀</span>
                <span class="tech-cell-label">Innovation</span>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<% if (theme.services && theme.services.length > 0) { %>
<section id="services" style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Services</div>
        <h2 class="section-title">Nos Expertises</h2>
    </div>

    <div class="services-detailed">
        <% 
        // Appliquer la limite de services
        var servicesLimit = theme.index && theme.index.services_limit ? theme.index.services_limit : 2;
        var servicesToShow = servicesLimit > 0 ? theme.services.slice(0, servicesLimit) : theme.services;
        
        servicesToShow.forEach(service => { %>
        <div class="service-detail-card">
            <div class="service-detail-icon"><%= service.icon %></div>
            <h3><%= service.name %></h3>
            <p><%= service.description %></p>
            <ul class="service-features">
                <% service.features.forEach(feature => { %>
                <li>✓ <%= feature %></li>
                <% }); %>
            </ul>
            <a href="/services/<%= service.slug %>/" class="btn btn-primary">En savoir plus →</a>
        </div>
        <% }); %>
    </div>
    
    <% if (servicesLimit > 0 && theme.services.length > servicesLimit) { %>
    <div style="text-align: center; margin-top: 3rem;">
        <a href="/services/" class="btn btn-secondary">
            Voir tous les services (<%= theme.services.length %>) →
        </a>
    </div>
    <% } %>
</section>
<% } %>

<!-- Blog Articles (Main Content) -->
<section id="articles" style="padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Blog Technique</div>
        <h2 class="section-title">Articles Récents</h2>
        <p style="text-align: center; color: var(--text-muted); max-width: 600px; margin: 1rem auto 0;">
            Découvrez nos derniers articles sur la cybersécurité, le développement embarqué et les technologies open source
        </p>
    </div>

    <div class="articles-grid">
        <% 
        var postsLimit = theme.index && theme.index.posts_limit ? theme.index.posts_limit : 6;
        var postsToShow = postsLimit > 0 ? page.posts.limit(postsLimit) : page.posts;
        
        postsToShow.each(post => { %>
            <%- partial('partials/article', {post: post}) %>
        <% }); %>
    </div>

    <% if (page.total > 1) { %>
    <nav class="pagination">
        <%- paginator({
            prev_text: '← Précédent',
            next_text: 'Suivant →',
            mid_size: 2,
            end_size: 1
        }) %>
    </nav>
    <% } %>
    
    <div style="text-align: center; margin-top: 3rem;">
        <a href="/archives/" class="btn btn-secondary">Voir tous les articles →</a>
    </div>
</section>

<!-- Categories Section -->
<section id="categories" style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Thématiques</div>
        <h2 class="section-title">Explorer par Catégorie</h2>
        <p style="text-align: center; color: var(--text-muted); max-width: 600px; margin: 1rem auto 0;">
            Parcourez nos articles classés par domaine d'expertise
        </p>
    </div>

    <div class="categories-grid">
        <% 
        // Liste des couleurs par défaut pour les catégories
        var defaultColors = ['#00d4ff', '#3b82f6', '#9945ff', '#10b981', '#8b5cf6', '#f59e0b', '#ef4444', '#ec4899', '#06b6d4', '#84cc16'];
        var defaultIcons = ['📁', '📂', '🗂️', '📋', '📄', '📃', '📝', '✏️', '📖', '📚'];
        
        // Appliquer la limite de catégories
        var categoriesLimit = theme.index && theme.index.categories_limit ? theme.index.categories_limit : 6;
        var allCategories = site.categories.sort('name');
        var categoriesToShow = categoriesLimit > 0 ? allCategories.limit(categoriesLimit) : allCategories;
        
        var categoryIndex = 0;
        
        categoriesToShow.each(function(category) {
            // Chercher la config dans le thème
            var catConfig = null;
            if (theme.categories) {
                for (var key in theme.categories) {
                    if (theme.categories[key].name === category.name) {
                        catConfig = theme.categories[key];
                        break;
                    }
                }
            }
            
            // Utiliser config du thème ou valeurs par défaut
            var icon = catConfig ? catConfig.icon : defaultIcons[categoryIndex % defaultIcons.length];
            var color = catConfig ? catConfig.color : defaultColors[categoryIndex % defaultColors.length];
            
            categoryIndex++;
        %>
        <a href="<%= url_for(category.path) %>" class="category-card" style="--category-color: <%= color %>">
            <div class="category-icon"><%= icon %></div>
            <div class="category-info">
                <h3 class="category-name"><%= category.name %></h3>
                <div class="category-count"><%= category.posts.length %> article<%= category.posts.length > 1 ? 's' : '' %></div>
            </div>
        </a>
        <% }); %>
    </div>
    
    <% if (categoriesLimit > 0 && allCategories.length > categoriesLimit) { %>
    <div style="text-align: center; margin-top: 3rem;">
        <a href="/categories/" class="btn btn-secondary">
            Voir toutes les catégories (<%= allCategories.length %>) →
        </a>
    </div>
    <% } %>
    
    <% if (allCategories.length === 0) { %>
    <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
        <p>Aucune catégorie pour le moment. Ajoutez des catégories à vos articles !</p>
    </div>
    <% } %>
</section>

<% if (theme.apps && theme.apps.length > 0) { %>
<section id="applications" style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Outils</div>
        <h2 class="section-title">Applications & Ressources</h2>
    </div>

    <div class="apps-grid">
        <% 
        // Appliquer la limite d'apps
        var appsLimit = theme.index && theme.index.apps_limit ? theme.index.apps_limit : 2;
        var appsToShow = appsLimit > 0 ? theme.apps.slice(0, appsLimit) : theme.apps;
        
        appsToShow.forEach(app => { %>
        <div class="app-card">
            <div class="app-preview">
                <iframe 
                    src="<%= app.url %>?embedded=true" 
                    title="<%= app.name %>"
                    loading="lazy">
                </iframe>
                <div class="app-overlay">
                    <a href="<%= app.url %>" target="_blank" class="btn btn-primary">
                        Ouvrir l'application ↗
                    </a>
                </div>
            </div>
            <div class="app-info">
                <h3><%= app.icon %> <%= app.name %></h3>
                <p><%= app.description %></p>
                <a href="<%= app.url %>" target="_blank" class="app-link">
                    Accéder à l'application →
                </a>
            </div>
        </div>
        <% }); %>
    </div>
    
    <% if (appsLimit > 0 && theme.apps.length > appsLimit) { %>
    <div style="text-align: center; margin-top: 3rem;">
        <a href="/apps/" class="btn btn-secondary">
            Voir toutes les applications (<%= theme.apps.length %>) →
        </a>
    </div>
    <% } %>
</section>
<% } %>

<% if (theme.youtube && theme.youtube.playlist_id) { %>
<section id="creations" style="padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Réalisations</div>
        <h2 class="section-title">Portfolio & Démonstrations</h2>
    </div>

    <div class="media-showcase">
        <div class="youtube-embed">
            <iframe 
                src="https://www.youtube.com/embed/videoseries?list=<%= theme.youtube.playlist_id %>" 
                title="<%= theme.youtube.title %>"
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
            </iframe>
        </div>
        
        <div class="media-info">
            <h3>🎬 <%= theme.youtube.title %></h3>
            <p><%= theme.youtube.description %></p>
            
            <div class="media-tags">
                <% theme.youtube.tags.forEach(tag => { %>
                <span class="media-tag"><%= tag %></span>
                <% }); %>
            </div>
            
            <a href="https://www.youtube.com/playlist?list=<%= theme.youtube.playlist_id %>" 
               class="btn btn-primary" 
               target="_blank"
               style="margin-top: 1rem;">
                Voir la chaîne →
            </a>
        </div>
    </div>
</section>
<% } %>

<section id="apropos" style="background: var(--bg-secondary); padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">À propos</div>
        <h2 class="section-title">Expertise & Parcours</h2>
    </div>

    <div class="about-content">
        <div class="about-text">
            <h3><%= theme.about.name %> — <%= theme.about.title %></h3>
            <%- markdown(theme.about.description) %>
            <div class="expertise-list">
                <% theme.about.expertise.forEach(item => { %>
                <span class="expertise-tag"><%= item %></span>
                <% }); %>
            </div>
        </div>

        <div class="about-visual">
            <div class="profile-card">
                <div class="profile-avatar"><%= theme.about.avatar %></div>
                <h4 class="profile-name"><%= theme.about.name %></h4>
                <p class="profile-title"><%= theme.about.title %></p>
                <div class="profile-stats">
                    <% theme.about.stats.forEach(stat => { %>
                    <div class="profile-stat">
                        <span class="profile-stat-value"><%= stat.value %></span>
                        <span class="profile-stat-label"><%= stat.label %></span>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="contact" style="padding: 4rem 2rem;">
    <div class="section-header">
        <div class="section-tag">Contact</div>
        <h2 class="section-title">Restons en Contact</h2>
    </div>

    <div class="contact-content">
        <div class="contact-info">
            <h3>Une question ? Un projet ?</h3>
            <p>
                Pour toute demande de prestation (pentest, développement, conseil), 
                contribution au blog, ou simplement pour échanger sur les technologies.
            </p>
            <div class="contact-methods">
                <% for (let name in theme.social) { %>
                <a href="<%= name === 'email' ? 'mailto:' + theme.social[name] : theme.social[name] %>" class="contact-method" target="_blank">
                    <div class="contact-method-icon">
                        <% if (name === 'email') { %>📧<% } %>
                        <% if (name === 'website') { %>🌐<% } %>
                        <% if (name === 'linkedin') { %>💼<% } %>
                        <% if (name === 'github') { %>💻<% } %>
                    </div>
                    <div>
                        <strong><%= name.charAt(0).toUpperCase() + name.slice(1) %></strong>
                        <div style="color: var(--text-muted); font-size: 0.9rem;"><%= theme.social[name] %></div>
                    </div>
                </a>
                <% } %>
            </div>
        </div>

        <% if (theme.contact && theme.contact.formspree_id) { %>
        <div class="contact-form">
            <form action="https://formspree.io/f/<%= theme.contact.formspree_id %>" method="POST">
                <input type="hidden" name="_subject" value="📧 Contact CyberMind Blog">
                <input type="hidden" name="_next" value="<%= config.url %>/merci/">
                <input type="text" name="_gotcha" style="display:none">
                
                <div class="form-group">
                    <label for="name">Nom / Organisation</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="sujet">Sujet</label>
                    <select id="sujet" name="sujet">
                        <% theme.contact.subjects.forEach(subject => { %>
                        <option value="<%= subject.value %>"><%= subject.label %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Décrivez votre demande..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-submit">Envoyer</button>
            </form>
        </div>
        <% } %>
    </div>
</section>
