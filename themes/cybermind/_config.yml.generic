# ═══════════════════════════════════════════════════════════════════════════════
# HEXO THEME CYBERMIND - Configuration Générique
# ═══════════════════════════════════════════════════════════════════════════════
# 
# Ce thème est conçu pour être 100% dynamique.
# Tout le contenu est géré via des fichiers Markdown dans source/
#
# Structure :
#   source/_data/           → Configuration du site (YAML)
#   source/services/        → Pages services (Markdown)
#   source/apps/            → Applications (Markdown)
#   source/portfolio/       → Portfolio/Réalisations (Markdown)
#   source/gallery/         → Galerie artistique (Markdown)
#   source/_posts/          → Articles de blog (Markdown)
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# THÈME
# ─────────────────────────────────────────────────────────────────────────────
theme:
  # Mode par défaut : 'dark' ou 'light'
  default_mode: dark
  
  # Permettre à l'utilisateur de changer
  allow_toggle: true
  
  # Couleur d'accent principale (utilisée partout)
  accent_color: "#f97316"  # Orange CyberMind
  
  # Couleur secondaire
  secondary_color: "#f59e0b"  # Amber

# ─────────────────────────────────────────────────────────────────────────────
# NAVIGATION
# Définir dans source/_data/navigation.yml pour plus de flexibilité
# Ou utiliser cette config simple
# ─────────────────────────────────────────────────────────────────────────────
menu:
  Accueil: /
  Services: /services/
  Apps: /apps/
  Portfolio: /portfolio/
  Articles: /archives/
  Contact: /contact/

# ─────────────────────────────────────────────────────────────────────────────
# RÉSEAUX SOCIAUX
# ─────────────────────────────────────────────────────────────────────────────
social:
  email: ""
  github: ""
  linkedin: ""
  youtube: ""
  twitter: ""
  mastodon: ""

# ─────────────────────────────────────────────────────────────────────────────
# BRANDING
# ─────────────────────────────────────────────────────────────────────────────
branding:
  # Logo texte affiché dans le header
  logo_text: "CyberMind_"
  
  # Symbole avant le logo
  logo_symbol: "◆"
  
  # Tagline
  tagline: ""
  
  # Logo image (optionnel, laissez vide pour texte seul)
  logo_image: ""
  
  # Favicon
  favicon: "/images/favicon.ico"

# ─────────────────────────────────────────────────────────────────────────────
# PAGE D'ACCUEIL - HERO
# ─────────────────────────────────────────────────────────────────────────────
hero:
  # Badge au-dessus du titre
  badge: ""
  
  # Titre principal (supporte HTML pour <br> et <span>)
  title: ""
  
  # Sous-titre
  subtitle: ""
  
  # Statistiques (tableau)
  stats: []
  #  - value: "25+"
  #    label: "Années"

# ─────────────────────────────────────────────────────────────────────────────
# SECTIONS PAGE D'ACCUEIL
# Activer/désactiver les sections
# ─────────────────────────────────────────────────────────────────────────────
sections:
  hero: true
  services: true
  apps: true
  portfolio: true
  articles: true
  categories: true
  tags: false
  youtube: false
  about: true
  contact: true

# ─────────────────────────────────────────────────────────────────────────────
# LIMITES D'AFFICHAGE
# Nombre d'éléments sur la page d'accueil (0 = tous)
# ─────────────────────────────────────────────────────────────────────────────
limits:
  posts: 6
  services: 3
  apps: 2
  portfolio: 4
  categories: 6
  tags: 15

# ─────────────────────────────────────────────────────────────────────────────
# YOUTUBE (optionnel)
# ─────────────────────────────────────────────────────────────────────────────
youtube:
  playlist_id: ""
  title: ""
  description: ""

# ─────────────────────────────────────────────────────────────────────────────
# CONTACT
# ─────────────────────────────────────────────────────────────────────────────
contact:
  # Formspree ID pour le formulaire
  formspree_id: ""
  
  # Email direct
  email: ""
  
  # Téléphone (optionnel)
  phone: ""
  
  # Adresse (optionnel)
  address: ""

# ─────────────────────────────────────────────────────────────────────────────
# FOOTER
# ─────────────────────────────────────────────────────────────────────────────
footer:
  copyright: "© 2025"
  links: []
  #  - text: "Mentions légales"
  #    url: "/legal/"
  
  # Afficher le lien vers le thème GitHub
  show_theme_credit: true
  theme_repo: "https://github.com/CyberMind-FR/hexo-theme-cybermind"

# ─────────────────────────────────────────────────────────────────────────────
# ARTICLES
# ─────────────────────────────────────────────────────────────────────────────
excerpt_length: 200
read_more: "Lire la suite →"
date_format: "DD MMMM YYYY"

# ─────────────────────────────────────────────────────────────────────────────
# COMMENTAIRES (optionnel)
# ─────────────────────────────────────────────────────────────────────────────
comments:
  enable: false
  # provider: disqus | utterances | giscus
  provider: ""
  # Config spécifique au provider
  config: {}

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS (optionnel)
# ─────────────────────────────────────────────────────────────────────────────
analytics:
  google: ""
  plausible: ""
  umami: ""

# ─────────────────────────────────────────────────────────────────────────────
# RECHERCHE (optionnel)
# ─────────────────────────────────────────────────────────────────────────────
search:
  enable: false

# ─────────────────────────────────────────────────────────────────────────────
# CODE HIGHLIGHTING
# ─────────────────────────────────────────────────────────────────────────────
highlight:
  enable: true
  theme: monokai
  line_number: true

# ─────────────────────────────────────────────────────────────────────────────
# COLLECTIONS DYNAMIQUES
# Ces dossiers sont scannés automatiquement pour créer les listings
# ─────────────────────────────────────────────────────────────────────────────
collections:
  services:
    path: "services"
    layout: "service"
    index_layout: "services"
    
  apps:
    path: "apps"
    layout: "app"
    index_layout: "apps"
    
  portfolio:
    path: "portfolio"
    layout: "portfolio"
    index_layout: "portfolio-index"
    
  gallery:
    path: "gallery"
    layout: "gallery-item"
    index_layout: "gallery"
